@model List<ClassLibrary.SubmissionModel>



<br />
<br />

<a asp-controller="Admin" asp-action="GetPdf" class="btn btn-primary">
    Download Serialnumbers
    <br />
    PDF 
</a>

<br />
<br />
<br />

<table class="table">
    <thead>
        <tr>
            <th>Id</th>
            <th>First Name</th>
            <th>Last Name</th>
            <th>E-Mail</th>
            <th>Serial Number</th>
            <th>Age</th>

        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.FirstName</td>
                <td>@item.LastName</td>
                <td>@item.Email</td>
                <td>@item.SerialNumber</td>
                <td>@item.Age</td>

            </tr>
        }
    </tbody>

</table>




@for (int i = 1; i <= ViewBag.TotalPages; i++)
{
    <a asp-action="GetSubmission" asp-route-page="@i">@i</a>
}

@if (ViewBag.CurrentPage > 1)
{
    <a asp-action="GetSubmission" asp-route-page="@(ViewBag.CurrentPage - 1)">Previous</a>
}

@if (ViewBag.CurrentPage < ViewBag.TotalPages)
{
    <a asp-action="GetSubmission" asp-route-page="@(ViewBag.CurrentPage + 1)">Next</a>
}



<br />
<br />
<br />
<br />
<form asp-area="Identity" asp-page="/Account/Logout" method="post">
    <button type="submit" class="btn btn-link">Log out</button>
</form>