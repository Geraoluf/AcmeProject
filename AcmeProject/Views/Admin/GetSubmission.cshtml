@model List<ClassLibrary.SubmissionModel>



<br />
<br />

<a asp-controller="Admin" asp-action="GetPdf" class="btn btn-primary">
    Download PDF
</a>

<br />
<br />

<table class="table">
    <thead>
        <tr>
            <th>Id</th>
            <th>First Name</th>
            <th>Last Name</th>
            <th>E-Mail</th>
            <th>Serial Number</th>

        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.FirstName</td>
                <td>@item.LastName</td>
                <td>@item.Email</td>
                <td>@item.SerialNumber</td>
                <td>@item.Age</td>

            </tr>
        }
    </tbody>

</table>


<form asp-area="Identity" asp-page="/Account/Logout" method="post">
    <button type="submit" class="btn btn-link">Log ud</button>
</form>